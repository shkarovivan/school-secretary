# Скопируйте в .env и заполните. .env в .gitignore.

# ── Интерфейс (временно — Telegram; вернёмся к MAX-боту позже) ──
# Токен от @BotFather в Telegram.
TELEGRAM_BOT_TOKEN=***REMOVED-TELEGRAM-TOKEN***

# Токен официального бота из dev.max.ru (когда появится).
MAX_BOT_TOKEN=

# Профиль userbot-моста: телефон аккаунта, чьи школьные чаты читаем.
# Логин делается один раз: python -m school_secretary.login
BRIDGE_PHONE=***REMOVED-PHONE***

# Подстроки названий чатов, которые считаем школьными (через запятую).
# Пусто = синхронизировать все групповые чаты.
SCHOOL_CHAT_FILTER=

# Сколько последних сообщений тянуть из чата за один sync (макс. 100).
SYNC_HISTORY_DEPTH=50
